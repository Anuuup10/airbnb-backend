<header
  class="bg-white/95 backdrop-blur-md border-b border-slate-100 shadow-xs sticky top-0 z-50 transition-all duration-300">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="h-16 flex justify-between items-center">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center space-x-2.5 group">
        <div
          class="p-2 rounded-2xl bg-rose-50 text-rose-500 group-hover:bg-rose-500 group-hover:text-white transition-all duration-200 shadow-xs">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6">
            </path>
          </svg>
        </div>
        <span
          class="text-xl font-bold tracking-tight text-slate-900 group-hover:text-rose-500 transition-colors">airbnb</span>
      </a>

      <!-- Desktop Navigation Links -->
      <div class="hidden md:flex items-center space-x-1.5">
        <% if(isLoggedIn) { %>
          <% if(user && user.userType === 'guest') { %>
            <a href="/homes"
              class="px-4 py-2 rounded-full text-xs font-semibold tracking-wide transition duration-200 <%= (typeof currentPage !== 'undefined' && currentPage === 'home') ? 'bg-rose-50 text-rose-600 font-bold shadow-xs' : 'text-slate-600 hover:text-rose-500 hover:bg-slate-50' %>">
              Homes List
            </a>
            <a href="/favourites"
              class="px-4 py-2 rounded-full text-xs font-semibold tracking-wide transition duration-200 <%= (typeof currentPage !== 'undefined' && currentPage === 'favourites') ? 'bg-rose-50 text-rose-600 font-bold shadow-xs' : 'text-slate-600 hover:text-rose-500 hover:bg-slate-50' %>">
              Favourites
            </a>
            <a href="/bookings"
              class="px-4 py-2 rounded-full text-xs font-semibold tracking-wide transition duration-200 <%= (typeof currentPage !== 'undefined' && currentPage === 'bookings') ? 'bg-rose-50 text-rose-600 font-bold shadow-xs' : 'text-slate-600 hover:text-rose-500 hover:bg-slate-50' %>">
              Bookings
            </a>
          <% } else {%>
            <a href="/host/host-home-list"
              class="px-4 py-2 rounded-full text-xs font-semibold tracking-wide transition duration-200 <%= (typeof currentPage !== 'undefined' && currentPage === 'host-homes') ? 'bg-rose-50 text-rose-600 font-bold shadow-xs' : 'text-slate-600 hover:text-rose-500 hover:bg-slate-50' %>">
              Host Homes
            </a>
            <a href="/host/add-home"
              class="px-4 py-2 rounded-full text-xs font-semibold tracking-wide transition duration-200 <%= (typeof currentPage !== 'undefined' && currentPage === 'addHome') ? 'bg-rose-50 text-rose-600 font-bold shadow-xs' : 'text-slate-600 hover:text-rose-500 hover:bg-slate-50' %>">
              Add Home
            </a>
          <% } %>
        <% } %>
      </div>

      <!-- Desktop Auth Actions -->
      <div class="hidden md:flex items-center space-x-2.5">
        <% if(!isLoggedIn) { %>
          <a href="/login"
            class="px-4 py-2 rounded-full text-xs font-semibold text-slate-700 hover:text-rose-500 hover:bg-slate-50 transition duration-200 <%= (typeof currentPage !== 'undefined' && currentPage === 'login') ? 'text-rose-600 font-bold' : '' %>">
            Login
          </a>
          <a href="/signup"
            class="px-5 py-2.5 rounded-full text-xs font-semibold bg-rose-500 hover:bg-rose-600 active:bg-rose-700 text-white shadow-sm hover:shadow transition duration-200">
            Sign Up
          </a>
        <% } else { %>
          <form action="/logout" method="POST" class="inline">
            <button type="submit"
              class="px-4 py-2 rounded-full text-xs font-semibold text-slate-600 hover:text-rose-600 hover:bg-rose-50 border border-slate-200 hover:border-rose-200 transition duration-200 cursor-pointer flex items-center space-x-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
              </svg>
              <span>Logout</span>
            </button>
          </form>
        <% } %>
      </div>

      <!-- Mobile Hamburger Toggle Button -->
      <div class="flex items-center md:hidden">
        <button id="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle navigation menu"
          class="p-2 rounded-xl text-slate-600 hover:text-rose-500 hover:bg-rose-50 border border-slate-200 transition duration-200 focus:outline-none focus:ring-2 focus:ring-rose-500/20">
          <!-- Icon when menu is closed (hamburger) -->
          <svg id="hamburger-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <!-- Icon when menu is open (close X) -->
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4 pt-2 border-t border-slate-100 transition-all duration-300 ease-in-out">
      <div class="flex flex-col space-y-1.5">
        <% if(isLoggedIn) { %>
          <% if(user && user.userType === 'guest') { %>
            <a href="/homes"
              class="px-4 py-2.5 rounded-xl text-sm font-medium transition duration-200 flex items-center space-x-2.5 <%= (typeof currentPage !== 'undefined' && currentPage === 'home') ? 'bg-rose-50 text-rose-600 font-bold' : 'text-slate-700 hover:bg-slate-50 hover:text-rose-500' %>">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
              <span>Homes List</span>
            </a>
            <a href="/favourites"
              class="px-4 py-2.5 rounded-xl text-sm font-medium transition duration-200 flex items-center space-x-2.5 <%= (typeof currentPage !== 'undefined' && currentPage === 'favourites') ? 'bg-rose-50 text-rose-600 font-bold' : 'text-slate-700 hover:bg-slate-50 hover:text-rose-500' %>">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.684a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
              <span>Favourites</span>
            </a>
            <a href="/bookings"
              class="px-4 py-2.5 rounded-xl text-sm font-medium transition duration-200 flex items-center space-x-2.5 <%= (typeof currentPage !== 'undefined' && currentPage === 'bookings') ? 'bg-rose-50 text-rose-600 font-bold' : 'text-slate-700 hover:bg-slate-50 hover:text-rose-500' %>">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              <span>Bookings</span>
            </a>
          <% } else {%>
            <a href="/host/host-home-list"
              class="px-4 py-2.5 rounded-xl text-sm font-medium transition duration-200 flex items-center space-x-2.5 <%= (typeof currentPage !== 'undefined' && currentPage === 'host-homes') ? 'bg-rose-50 text-rose-600 font-bold' : 'text-slate-700 hover:bg-slate-50 hover:text-rose-500' %>">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0V11m0 0h4m-4 0H9"></path></svg>
              <span>Host Homes</span>
            </a>
            <a href="/host/add-home"
              class="px-4 py-2.5 rounded-xl text-sm font-medium transition duration-200 flex items-center space-x-2.5 <%= (typeof currentPage !== 'undefined' && currentPage === 'addHome') ? 'bg-rose-50 text-rose-600 font-bold' : 'text-slate-700 hover:bg-slate-50 hover:text-rose-500' %>">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              <span>Add Home</span>
            </a>
          <% } %>

          <div class="pt-2 mt-1 border-t border-slate-100">
            <form action="/logout" method="POST">
              <button type="submit"
                class="w-full text-left px-4 py-2.5 rounded-xl text-sm font-medium text-rose-600 hover:bg-rose-50 transition duration-200 flex items-center space-x-2.5 cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
                <span>Logout</span>
              </button>
            </form>
          </div>
        <% } else { %>
          <a href="/homes"
            class="px-4 py-2.5 rounded-xl text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-rose-500 transition duration-200 flex items-center space-x-2.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            <span>Explore Homes</span>
          </a>
          <div class="pt-2 mt-1 border-t border-slate-100 flex flex-col space-y-2">
            <a href="/login"
              class="w-full text-center px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-100 transition duration-200 border border-slate-200">
              Login
            </a>
            <a href="/signup"
              class="w-full text-center px-4 py-2.5 rounded-xl text-sm font-semibold bg-rose-500 hover:bg-rose-600 text-white shadow-sm transition duration-200">
              Sign Up
            </a>
          </div>
        <% } %>
      </div>
    </div>
  </nav>
</header>

<script>
  (function() {
    function initMobileMenu() {
      const toggleBtn = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      if (toggleBtn && mobileMenu && !toggleBtn.dataset.initialized) {
        toggleBtn.dataset.initialized = 'true';
        toggleBtn.addEventListener('click', function() {
          const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
          toggleBtn.setAttribute('aria-expanded', !isExpanded);
          mobileMenu.classList.toggle('hidden');
          if (hamburgerIcon && closeIcon) {
            hamburgerIcon.classList.toggle('hidden');
            hamburgerIcon.classList.toggle('block');
            closeIcon.classList.toggle('hidden');
            closeIcon.classList.toggle('block');
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMobileMenu);
    } else {
      initMobileMenu();
    }
  })();
</script>