<header class="bg-red-500 text-white p-4 shadow-md">
  <nav class="container mx-auto flex justify-between items-center">
    <ul class="flex space-x-2">
      <li>
        <a
          href="/"
          class="py-2 px-4 rounded-lg transition duration-300 inline-block <%= (typeof currentPage !== 'undefined' && currentPage === 'home') ? 'bg-red-700 font-semibold text-white shadow-inner' : 'hover:bg-red-400 text-white/90 hover:text-white' %>"
        >Home</a>
      </li>
      <li>
        <a
          href="/host/add-home"
          class="py-2 px-4 rounded-lg transition duration-300 inline-block <%= (typeof currentPage !== 'undefined' && currentPage === 'addHome') ? 'bg-red-700 font-semibold text-white shadow-inner' : 'hover:bg-red-400 text-white/90 hover:text-white' %>"
        >Add Home</a>
      </li>
    </ul>
  </nav>
</header>