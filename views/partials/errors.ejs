<% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
            <div class="p-4 rounded-2xl bg-rose-50/90 border border-rose-200/80 shadow-xs backdrop-blur-xs transition-all duration-300">
              <div class="flex items-start space-x-3">
                <div class="shrink-0 p-1.5 rounded-xl bg-rose-100 text-rose-600 mt-0.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="text-xs font-bold uppercase tracking-wider text-rose-900">Please check the following</h3>
                  <ul class="mt-2 space-y-1 text-xs text-rose-700 font-medium">
                    <% errors.forEach(error => { %>
                      <li class="flex items-start space-x-1.5">
                        <span class="text-rose-400 font-bold">•</span>
                        <span><%= error %></span>
                      </li>  
                    <% }) %>
                  </ul>
                </div>
              </div>
            </div>
            <% } %>