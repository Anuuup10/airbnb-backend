<%- include('partials/head') %>
  </head>

  <body>
    <%- include('partials/nav') %>
      <main class="container mx-auto px-4 py-8 max-w-6xl">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-8 text-center">
          Registered Homes
        </h1>

        <% if (registeredHomes.length===0) { %>
          <div class="bg-white border border-gray-200 rounded-2xl p-8 text-center max-w-md mx-auto my-8 shadow-sm">
            <p class="text-gray-500 text-base mb-4">No homes registered yet.</p>
            <a href="/host/add-home"
              class="inline-block bg-rose-500 hover:bg-rose-600 text-white font-semibold px-5 py-2 rounded-xl text-sm transition">
              Add Your Home
            </a>
          </div>
          <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              <% registeredHomes.forEach(home=> { %>
                <div
                  class="bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-lg transition duration-300 overflow-hidden flex flex-col justify-between">
                  <% if (home.photoUrl && home.photoUrl.trim() !=='' ) { %>
                    <div class="h-48 w-full overflow-hidden bg-gray-100">
                      <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="w-full h-full object-cover" />
                    </div>
                    <% } %>

                      <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
                        <div>
                          <div class="flex items-center justify-between text-xs text-gray-500 mb-1">
                            <span>
                              <%= home.location || 'Location' %>
                            </span>
                            <% if (home.rating) { %>
                              <span class="text-amber-500 font-semibold">★ <%= home.rating %></span>
                              <% } %>
                          </div>
                          <h2 class="text-xl font-bold text-gray-900">
                            <%= home.houseName %>
                          </h2>
                          <% if (home.description) { %>
                            <p class="text-xs text-gray-500 mt-1">
                              <%= home.description %>
                            </p>
                            <% } %>
                        </div>

                        <div class="pt-3 border-t border-gray-100 flex items-center justify-between">
                          <div>
                            <span class="text-lg font-bold text-gray-900">$<%= home.price || '0' %></span>
                            <span class="text-xs text-gray-500">/ night</span>
                          </div>
                        </div>
                      </div>
                </div>
                <% }) %>
            </div>
            <% } %>
      </main>
  </body>

  </html>