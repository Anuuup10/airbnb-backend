<%- include('../partials/head') %>
  </head>

  <body>
    <%- include('../partials/nav') %>
      <main class="container mx-auto px-4 py-8 max-w-6xl">
        <!-- <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-8 text-center">
          Hey Host! Here are your homes:
        </h1> -->

        <% if (registeredHomes.length===0) { %>
          <div class="bg-white border border-gray-200 rounded-2xl p-8 text-center max-w-md mx-auto my-8 shadow-sm">
            <p class="text-gray-500 text-base mb-4">No homes registered yet.</p>
            <a href="/host/add-home"
              class="inline-block bg-rose-500 hover:bg-rose-600 text-white font-semibold px-5 py-2 rounded-xl text-sm transition">
              Add Your Home
            </a>
          </div>
          <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              <% registeredHomes.forEach(home=> { %>
                <div
                  class="bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-lg transition duration-300 overflow-hidden flex flex-col justify-between">
                  <% if (home.photoUrl && home.photoUrl.trim() !=='' ) { %>
                    <div class="h-48 w-full overflow-hidden bg-gray-100">
                      <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="w-full h-full object-cover" />
                    </div>
                    <% } %>

                      <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
                        <div>
                          <div class="flex items-center justify-between text-xs text-gray-500 mb-1">
                            <span>
                              <%= home.location || 'Location' %>
                            </span>
                            <% if (home.rating) { %>
                              <span class="text-amber-500 font-semibold">★ <%= home.rating %></span>
                              <% } %>
                          </div>
                          <h2 class="text-xl font-bold text-gray-900">
                            <%= home.houseName %>
                          </h2>
                          <% if (home.description) { %>
                            <p class="text-xs text-gray-500 mt-1">
                              <%= home.description %>
                            </p>
                            <% } %>
                        </div>

                        <div class="pt-3 border-t border-gray-100 flex items-center justify-between gap-2 flex-wrap">
                          <div class="shrink-0">
                            <span class="text-lg font-bold text-gray-900">$<%= home.price || '0' %></span>
                            <span class="text-xs text-gray-500">/ night</span>
                          </div>
                          <div class="flex items-center gap-2 shrink-0">
                            <a href="/host/edit-home/<%= home._id || '' %>?editing=true" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-3 py-1.5 rounded-xl text-xs shadow-sm hover:shadow-md hover:-translate-y-0.5 active:scale-95 transition-all duration-200 inline-flex items-center gap-1 cursor-pointer shrink-0">
                              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                              </svg>
                              <span>Edit</span>
                            </a>
                            <form action="/host/delete-home/<%= home._id || '' %>" method="POST" class="inline-flex shrink-0 m-0 p-0">
                              <button type="submit" class="bg-rose-500 hover:bg-rose-600 text-white font-semibold px-3 py-1.5 rounded-xl text-xs shadow-sm hover:shadow-md hover:-translate-y-0.5 active:scale-95 transition-all duration-200 inline-flex items-center gap-1 cursor-pointer">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                                <span>Delete</span>
                              </button>
                            </form>
                          </div>
                        </div>
                      </div>
                </div>
                <% }) %>
            </div>
            <% } %>
      </main>
  </body>

  </html>